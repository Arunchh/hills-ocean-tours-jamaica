# Hills Ocean Tours — environment variables
# Full setup guide: docs/CLIENT-SETUP-CHECKLIST.md

# Tawk.to live chat — get IDs from Administration → Channels → Chat Widget
# Direct Chat Link format: https://tawk.to/chat/{PROPERTY_ID}/{WIDGET_ID}
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# Optional: Web3Forms contact form (falls back to mailto when empty)
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Google Sheet booking API (see docs/BOOKING-SHEET-SETUP.md)
# BOOKING_SCRIPT_URL=https://script.google.com/macros/s/YOUR_ID/exec
# BOOKING_SCRIPT_SECRET=same-value-as-BOOKING_SECRET-in-apps-script
